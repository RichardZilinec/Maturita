subor_hlasy = open("hlasovanie_1.txt", "r", encoding="utf-8")
#
#
#
poradia = {}
for i in range(5220, 5230):
    poradia[str(i)] = []

celkovy_pocet_sms = 0

for riadok in subor_hlasy:
    cislo = riadok.strip()
    
    if cislo != "":
        celkovy_pocet_sms = celkovy_pocet_sms + 1

        if cislo in poradia:
            poradia[cislo].append(celkovy_pocet_sms)

subor_hlasy.close()

print("Celkový počet zaslaných SMS:", celkovy_pocet_sms)

for i in range(5220, 5230):
    nazov_suboru = str(i) + ".txt"
    vystupny_subor = open(nazov_suboru, "w", encoding="utf-8")

    zoznam_poradi = poradia[str(i)]

    for poradove_cislo in zoznam_poradi:
        vystupny_subor.write(str(poradove_cislo) + "\n")
        
    vystupny_subor.close()
