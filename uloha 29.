def spracuj_riadok(riadok):
    if len(riadok) > 0 and riadok[-1] == "\n":
        riadok = riadok[:-1]

    vysledok_zoznam = []
    aktualny_znak = "0"
    i = 0
    dlzka = len(riadok)

    while i < dlzka:
        pocet = 0
        while i < dlzka and riadok[i] == aktualny_znak:
            pocet += 1
            i += 1

        vysledok_zoznam.append(str(pocet))

        if aktualny_znak == "0":
            aktualny_znak = "1"
        else:
            aktualny_znak = "0"

    vystupny_riadok = ""
    for j in range(len(vysledok_zoznam)):
        vystupny_riadok = vystupny_riadok + vysledok_zoznam[j]
        if j < len(vysledok_zoznam) - 1:
            vystupny_riadok = vystupny_riadok + " "

    return vystupny_riadok
