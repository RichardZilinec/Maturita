subor = open("kompresia_obrazka_1.txt", "r", encoding="utf-8")
prvy_riadok = subor.readline()

if len(prvy_riadok) > 0 and prvy_riadok[-1] == "\n":
    prvy_riadok = prvy_riadok[:-1]

casti = prvy_riadok.split(" ")
sirka = int(casti[0])
vyska = int(casti[1])
pocet_bodov = sirka * vyska

print("Šírka obrázka:", sirka)
print("Výška obrázka:", vyska)
print("Počet všetkých bodov:", pocet_bodov)

prvy_obrazkovy_riadok = subor.readline()
vysledok_prveho = spracuj_riadok(prvy_obrazkovy_riadok)
print("Spracovaný prvý riadok:", vysledok_prveho)

subor.close()
