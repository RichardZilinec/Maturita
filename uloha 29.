subor_vstup = open("kompresia_obrazka_1.txt", "r", encoding="utf-8")
subor_vystup = open("kompresia_obrazka_vystup.txt", "w", encoding="utf-8")

rozmery_riadok = subor_vstup.readline()
subor_vystup.write(rozmery_riadok)

for riadok in subor_vstup:
    skomprimovany_riadok = spracuj_riadok(riadok)
    subor_vystup.write(skomprimovany_riadok + "\n")

subor_vstup.close()
subor_vystup.close()
