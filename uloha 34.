def spracuj_riadok(riadok):
    if len(riadok) > 0 and riadok[-1] == "\n":
        riadok = riadok[:-1]

    if len(riadok) == 0:
        return ""

    cisla_text = riadok.split(" ")
    cisla = []
    for c in cisla_text:
        cisla.append(int(c))

    vystupny_riadok = ""
    aktualna_farba = "0"

    for pocet in cisla:
        j = 0
        while j < pocet:
            vystupny_riadok = vystupny_riadok + aktualna_farba
            j = j + 1

        if aktualna_farba == "0":
            aktualna_farba = "1"
        else:
            aktualna_farba = "0"

    return vystupny_riadok
