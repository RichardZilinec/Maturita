subor = open("ciernobiely_obrazok_1.txt", "r", encoding="utf-8")
prvy_riadok = subor.readline()
#
#
#
if len(prvy_riadok) > 0 and prvy_riadok[-1] == "\n":
    prvy_riadok = prvy_riadok[:-1]

casti = prvy_riadok.split(" ")
sirka = int(casti[0])
vyska = int(casti[1])
pocet_bodov = sirka * vyska

print("Šírka obrázka:", sirka)
print("Výška obrázka:", vyska)
print("Počet všetkých bodov:", pocet_bodov)

prvy_obrazkovy_riadok = subor.readline()
vysledok_prveho = spracuj_riadok(prvy_obrazkovy_riadok)
print("Spracovaný prvý riadok:", vysledok_prveho)

subor.close()

subor_vstup = open("ciernobiely_obrazok_1.txt", "r", encoding="utf-8")
subor_vystup = open("konverzia_suboru_1_vystup.txt", "w", encoding="utf-8")

rozmery_riadok = subor_vstup.readline()
subor_vystup.write(rozmery_riadok)

for riadok in subor_vstup:
    skonvertovany_riadok = spracuj_riadok(riadok)
    subor_vystup.write(skonvertovany_riadok + "\n")

subor_vstup.close()
subor_vystup.close()
