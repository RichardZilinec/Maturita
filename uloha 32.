def spracuj_riadok(riadok):
    if len(riadok) > 0 and riadok[-1] == "\n":
        riadok = riadok[:-1]

    vysledok_zoznam = []
    i = 0
    while i < len(riadok):
        hex_cislo = riadok[i] + riadok[i+1]
        desatinne_cislo = int(hex_cislo, 16)

        if desatinne_cislo < 128:
            vysledok_zoznam.append("0")
        else:
            vysledok_zoznam.append("1")
        i = i + 2

    vystupny_riadok = ""
    for j in range(len(vysledok_zoznam)):
        vystupny_riadok = vystupny_riadok + vysledok_zoznam[j]
        if j < len(vysledok_zoznam) - 1:
            vystupny_riadok = vystupny_riadok + " "

    return vystupny_riadok
#
