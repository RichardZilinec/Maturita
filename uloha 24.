import random
#
#
#
akcia = input("Chceš text zašifrovať (s) alebo dešifrovať (d)? ")
#
#
#
vstupny_subor = "vstupny_text.txt"
vystupny_subor = "zasifrovany_text_2.txt"
#
#
#
if akcia == "d":
    vstupny_subor, vystupny_subor = vystupny_subor, vstupny_subor

subor1 = open(vstupny_subor, "r", encoding="utf-8")
subor2 = open(vystupny_subor, "w", encoding="utf-8")
#
#
#
for riadok in subor1:
    ma_enter = False
    if len(riadok) > 0 and riadok[-1] == "\n":
        riadok = riadok[:-1]
        ma_enter = True

    novy_riadok = ""

    if akcia == "s":
        posun = random.randint(1, 25)

        pismeno_posunu = chr(posun + 96)
        novy_riadok = pismeno_posunu

        for znak in riadok:
            if "a" <= znak <= "z":
                stara_pozicia = ord(znak) - 97
                nova_pozicia = (stara_pozicia + posun) % 26
                novy_riadok = novy_riadok + chr(nova_pozicia + 97)
            else:
                novy_riadok = novy_riadok + znak
    #
    #
    #
    else:
        if len(riadok) > 0:
            pismeno_posunu = riadok[0]
            posun = ord(pismeno_posunu) - 96
            for znak in riadok[1:]:
                if "a" <= znak <= "z":
                    stara_pozicia = ord(znak) - 97
                    nova_pozicia = (stara_pozicia - posun) % 26
                    novy_riadok = novy_riadok + chr(nova_pozicia + 97)
                else:
                    novy_riadok = novy_riadok + znak
        else:
            novy_riadok = ""
    if ma_enter:
        novy_riadok = novy_riadok + "\n"
    subor2.write(novy_riadok)
#
#
#
subor1.close()
subor2.close()
